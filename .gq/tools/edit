#!/usr/bin/env python3
"""Replace one exact text occurrence in a UTF-8 text file."""
import argparse
import os
import sys
import tempfile

parser = argparse.ArgumentParser(description="Replace exact text in a text file")
parser.add_argument("--path", required=True)
parser.add_argument("--oldtext", required=True)
parser.add_argument("--newtext", required=True)
args = parser.parse_args()

try:
    data = open(args.path, "rb").read()
except OSError as exc:
    print(f"edit: {exc}", file=sys.stderr)
    sys.exit(1)

if b"\x00" in data:
    print("edit: refusing to edit binary file", file=sys.stderr)
    sys.exit(1)
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    print("edit: refusing to edit non-UTF-8 binary file", file=sys.stderr)
    sys.exit(1)

count = text.count(args.oldtext)
if count == 0:
    print("edit: oldtext was not found", file=sys.stderr)
    sys.exit(1)
if count != 1:
    print(f"edit: oldtext must occur exactly once (found {count})", file=sys.stderr)
    sys.exit(1)

updated = text.replace(args.oldtext, args.newtext, 1)
directory = os.path.dirname(os.path.abspath(args.path)) or "."
mode = os.stat(args.path).st_mode
fd, temporary = tempfile.mkstemp(prefix=".gq-edit-", dir=directory)
try:
    with os.fdopen(fd, "w", encoding="utf-8", newline="") as output:
        output.write(updated)
    os.chmod(temporary, mode)
    os.replace(temporary, args.path)
except Exception:
    try:
        os.unlink(temporary)
    except OSError:
        pass
    raise
