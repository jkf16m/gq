#!/usr/bin/env python3
"""Read one UTF-8 text file; refuse binary content."""
import argparse
import sys

parser = argparse.ArgumentParser(description="Safely read a text file")
parser.add_argument("path", nargs="?", default=None, help="File to read (positional)")
parser.add_argument("--path", default=None, dest="flag_path", help="File to read (--path form)")
args = parser.parse_args()

path = args.path or args.flag_path
if not path:
    print("cat: no file specified", file=sys.stderr)
    sys.exit(1)

try:
    data = open(path, "rb").read()
except OSError as exc:
    print(f"cat: {exc}", file=sys.stderr)
    sys.exit(1)

if b"\x00" in data:
    print("cat: refusing to read binary file", file=sys.stderr)
    sys.exit(1)
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    print("cat: refusing to read non-UTF-8 binary file", file=sys.stderr)
    sys.exit(1)

sys.stdout.write(text)
